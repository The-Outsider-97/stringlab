{
  "name": "slai-stringlab",
  "version": "1.0.0",
  "description": "SLAI StringLab: classical and quantum string physics. TypeScript client + Python SLAI service, on the shared SLAI tools kit.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../tools/build/build-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests_ts/*.test.ts",
    "test:compiled": "tsc -p tsconfig.test.json && node --test .test-out/stringlab/tests_ts/*.test.js",
    "test:py": "python3 -m pytest tests -q",
    "start": "npm run build && python3 -m applications.stringlab"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

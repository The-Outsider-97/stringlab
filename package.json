{
  "name": "slai-stringlab",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.mkdirSync('dist',{recursive:true});for(const n of ['index.html','styles.css'])fs.copyFileSync('src/client/'+n,'dist/'+n)\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}

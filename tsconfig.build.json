{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "rootDir": "src/client", "outDir": "dist", "noEmitOnError": true
  },
  "include": ["src/client/*.ts"]
}

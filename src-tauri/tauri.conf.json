{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLAI StringLab",
  "version": "0.7.0",
  "identifier": "com.slai.stringlab",
  "build": {
    "frontendDist": "../desktop/loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SLAI StringLab",
        "width": 1440,
        "height": 900,
        "minWidth": 950,
        "minHeight": 650,
        "resizable": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Scientific string-physics simulation and visualization",
    "category": "Education",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "targets": ["nsis"]
  }
}